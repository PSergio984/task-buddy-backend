# Snyk policy file — project-level ignores.
version: v1.5.0
ignore:
  # nltk is used ONLY for PorterStemmer with a local stopwords file
  # (app/knowledge/retrieval/tokenize.py); the vulnerable data-downloader
  # code paths (download/verify/download URLs) are never executed.
  SNYK-PYTHON-NLTK-17821336:
    - "*":
        reason: nltk data downloader not used - local stopwords.txt + PorterStemmer only
        expires: 2027-08-13
  SNYK-PYTHON-NLTK-18592338:
    - "*":
        reason: nltk data downloader not used - local stopwords.txt + PorterStemmer only
        expires: 2027-08-13
  # torch + transformers (transitive via sentence-transformers): no fixed
  # version exists upstream (fixedIn=[] on all CVEs). The listed issues are
  # pickle-deserialization/arbitrary-code-injection in MODEL LOADING and C++
  # kernel memory bugs. Our usage loads exactly one model, pinned by repo id
  # (EMBEDDING_MODEL), baked into the Docker image at build time — untrusted
  # model files are never loaded at runtime, and no untrusted tensor input
  # reaches the affected kernels (we encode text only).
  SNYK-PYTHON-TORCH-10332643:
    - "*":
        reason: no upstream fix; pinned baked model only, no untrusted model loading
        expires: 2027-08-13
  SNYK-PYTHON-TORCH-10337825:
    - "*":
        reason: no upstream fix; pinned baked model only, no untrusted model loading
        expires: 2027-08-13
