{
  "uid": "task-buddy-overview",
  "title": "Task Buddy — Overview",
  "tags": ["task-buddy"],
  "timezone": "browser",
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by status",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total{job=\"task-buddy-backend\"}[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latency p50 / p95 (seconds)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"task-buddy-backend\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"task-buddy-backend\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx error rate (user-impacting)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"task-buddy-backend\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"task-buddy-backend\"}[5m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "App logs (click a line to jump to its trace)",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": false,
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=\"task-buddy-backend\"}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Top endpoints by request rate",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (handler) (rate(http_requests_total{job=\"task-buddy-backend\"}[5m])))",
          "legendFormat": "{{handler}}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
